# Template for generated PKGBUILD.release.
# Edit this file and run `make pkgbuild-release`.

pkgname=lambcrypt
pkgver=@VERSION@
pkgrel=1
pkgdesc='Disk encryption with strong security based on TrueCrypt'
url='https://github.com/e3742526/LambCrypt'
arch=(x86_64 aarch64 armv7h)
license=('LicenseRef-TrueCrypt AND Apache-2.0')
depends=(
  device-mapper
  fuse2
  gcc-libs
  glibc
  libsm
  wxwidgets-common
  wxwidgets-gtk3
)
# Enable with INDICATOR=1 makepkg -p PKGBUILD.release -si.
_indicator_make_flags=()
case "${INDICATOR:-0}" in
  0) ;;
  1)
    depends+=(libayatana-appindicator)
    _indicator_make_flags=(INDICATOR=1)
    ;;
  *)
    printf 'INDICATOR must be 0 or 1\n' >&2
    return 1
    ;;
esac
optdepends=(
  'pcsclite: EMV and smart card keyfile support'
  'sudo: mounting encrypted volumes as nonroot users'
)
makedepends=(
  pcsclite
)
makedepends_x86_64=(
  yasm
)
# Use the fork's source archive, detached signature and signing key.
_source_archive="LambCrypt_${pkgver}_Source.tar.bz2"
source=(
  "${_source_archive}::${LAMBCRYPT_SOURCE_URL:?Set the LambCrypt release source URL}"
  "${_source_archive}.sig::${LAMBCRYPT_SOURCE_SIGNATURE_URL:?Set the detached signature URL}"
)
validpgpkeys=("${LAMBCRYPT_SOURCE_SIGNING_KEY:?Set the release signing key fingerprint}")
sha512sums=(
  "${LAMBCRYPT_SOURCE_SHA512:?Set the release source SHA-512 checksum}"
  'SKIP'
)

prepare() {
  local source_version

  source_version="$(awk -F '"' '/^[[:space:]]*#define[[:space:]]+VERSION_STRING[[:space:]]*"/ { print $2; exit }' "${srcdir}/src/Common/Tcdefs.h")"
  if [[ "${source_version}" != "${pkgver}" ]]; then
    printf 'PKGBUILD pkgver (%s) does not match source VERSION_STRING (%s)\n' "${pkgver}" "${source_version}" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/src"
  # Rebuild objects when switching the AppIndicator setting.
  make PKG_CONFIG_PATH=/usr/lib/pkgconfig \
    WX_CONFIG=/usr/bin/wx-config \
    TC_EXTRA_LFLAGS="${LDFLAGS}" \
    TC_EXTRA_CXXFLAGS="${CXXFLAGS} ${CPPFLAGS}" \
    TC_EXTRA_CFLAGS="${CFLAGS} ${CPPFLAGS}" \
    NOTEST=1 \
    "${_indicator_make_flags[@]}" \
    clean

  make PKG_CONFIG_PATH=/usr/lib/pkgconfig \
    WX_CONFIG=/usr/bin/wx-config \
    TC_EXTRA_LFLAGS="${LDFLAGS}" \
    TC_EXTRA_CXXFLAGS="${CXXFLAGS} ${CPPFLAGS}" \
    TC_EXTRA_CFLAGS="${CFLAGS} ${CPPFLAGS}" \
    NOTEST=1 \
    NOSTRIP=1 \
    "${_indicator_make_flags[@]}"
}

check() {
  cd "${srcdir}/src"
  ./Main/lambcrypt --text --test >/dev/null
}

package() {
  cd "${srcdir}/src"
  make DESTDIR="${pkgdir}" \
    INSTALL_UNINSTALLER=0 \
    INSTALL_APPIMAGE_FILES=0 \
    INSTALL_MOUNT_HELPER_DIR=bin \
    INSTALL_LICENSE_DIR="share/licenses/${pkgname}" \
    NOSTRIP=1 \
    "${_indicator_make_flags[@]}" \
    install
}

# vim: ts=2 sw=2 et:
