;;;
;;; LambCrypt
;;;
;;;
;;; Copyright (c) 2026, IDRIX
;;;

[Version]
signature   = "$Windows NT$"
Class       = "Encryption"                              ;This is determined by the work this filter driver does
ClassGuid   = {a0a701c0-a511-42ff-aa6c-06dc0395576f}    ;This value is determined by the Class
Provider    = %ProviderString%
DriverVer = 11/18/2026,1.27.0.0
CatalogFile = lambcrypt.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
lambcrypt.DriverFiles  = 12            ;%windir%\system32\drivers

;;
;; Default install sections
;;

[DefaultInstall.NTx86]
OptionDesc          = %ServiceDescription%
CopyFiles           = lambcrypt.DriverFiles
AddReg              = lambcrypt.AddReg

[DefaultInstall.NTamd64]
OptionDesc          = %ServiceDescription%
CopyFiles           = lambcrypt.DriverFiles
AddReg              = lambcrypt.AddReg

[DefaultInstall.NTarm64]
OptionDesc          = %ServiceDescription%
CopyFiles           = lambcrypt.DriverFiles
AddReg              = lambcrypt.AddReg

[DefaultInstall.NTx86.Services]
AddService          = lambcrypt,,lambcrypt.Service

[DefaultInstall.NTamd64.Services]
AddService          = lambcrypt,,lambcrypt.Service

[DefaultInstall.NTarm64.Services]
AddService          = lambcrypt,,lambcrypt.Service

;
; Services Section
;

[lambcrypt.Service]
DisplayName      = %ServiceDescription%
Description      = %ServiceDescription%
ServiceBinary    = %12%\lambcrypt.sys        ;%windir%\system32\drivers\
ServiceType      = 2                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 0                           ;SERVICE_BOOT_START
ErrorControl     = 1                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "Filter"

;
; Copy Files
;

[lambcrypt.DriverFiles]
lambcrypt.sys

[SourceDisksFiles]
lambcrypt.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

;
; Registry Entries
;

[lambcrypt.AddReg]
HKLM, System\CurrentControlSet\Control\Class\{4d36e967-e325-11ce-bfc1-08002be10318}, UpperFilters, 0x00010008, lambcrypt
HKLM, System\CurrentControlSet\Control\Class\{4d36e967-e325-11ce-bfc1-08002be10318}, UpperFilters, 0x00010008, PartMgr

;;
;; String Section
;;

[Strings]
ProviderString          = "LambCrypt contributors"
ServiceDescription      = "lambcrypt"
DiskId1                 = "LambCrypt Device Installation Disk"

