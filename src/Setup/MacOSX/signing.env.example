# Copy to signing.local.env outside the checkout and fill in values for your team.
# The signing certificate and private key live in Keychain.
# Use an Apple Development identity and an FSKit development profile for VM tests.
export VC_APP_SIGN_IDENTITY=''
export VC_FSKIT_PROVISIONING_PROFILE=''
# Optional build number for distinguishing FSKit candidates with the same version.
# export VC_FSKIT_BUILD_VERSION=''

# For FSKit distribution, use a Developer ID Application identity and a matching
# FSKit Developer ID provisioning profile above.
export VC_SIGN_TEAM_ID=''
export VC_INSTALLER_SIGN_IDENTITY=''
export VC_NOTARY_PROFILE=''
# export VC_NOTARY_KEYCHAIN=''
