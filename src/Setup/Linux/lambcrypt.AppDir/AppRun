#!/bin/sh
# Modified for LambCrypt by the LambCrypt contributors. Changes from VeraCrypt are in the git history; see UPSTREAM.md.
# Get the directory where AppRun is located
APPDIR=$(dirname "$(readlink -f "$0")")

# Prefer libraries bundled inside the AppImage. This lets the official
# AppImage carry the FUSE userspace library required by its LambCrypt binary
# on systems where that library is not installed by default.
if [ -d "${APPDIR}/usr/lib" ]; then
    if [ -n "${LD_LIBRARY_PATH:-}" ]; then
        export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH}"
    else
        export LD_LIBRARY_PATH="${APPDIR}/usr/lib"
    fi
fi

# Execute the main LambCrypt application
exec "${APPDIR}/usr/bin/lambcrypt" "$@"
