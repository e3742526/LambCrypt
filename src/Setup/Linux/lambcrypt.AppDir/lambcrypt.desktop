# Modified for LambCrypt by the LambCrypt contributors. Changes from VeraCrypt are in the git history; see UPSTREAM.md.
[Desktop Entry]
Type=Application
Name=LambCrypt
GenericName=LambCrypt volume manager
Comment=Create and mount LambCrypt encrypted volumes
Icon=lambcrypt
Exec=AppRun
Categories=System;Security;Utility;Filesystem;
Keywords=encryption,filesystem
Terminal=false
MimeType=application/x-veracrypt-volume;application/x-truecrypt-volume;
